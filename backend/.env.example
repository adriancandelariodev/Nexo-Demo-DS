# Copia este archivo como .env para correr el proyecto en tu computadora.
# En Vercel estas variables se configuran en Settings → Environment Variables.

# Cadena de conexión de Postgres (Neon). Al conectar Neon desde Vercel se crea sola.
DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/neondb?sslmode=require

# Llave para firmar las sesiones. Usa una cadena aleatoria de 32 caracteres o más.
AUTH_SECRET=cambia-esto-por-una-cadena-aleatoria-muy-larga-y-secreta

# Opcional: solo permite correos de este dominio (sin @). Ej: tuempresa.mx
EMAIL_DOMAIN=

# IA con n8n (ver n8n/README.md). Déjalas vacías si todavía no conectas n8n.
# Production URL del webhook del flujo "Nexo · Asistente"
N8N_ASISTENTE_URL=
# Secreto compartido: el mismo valor que pones en la credencial "Nexo · secreto" de n8n
N8N_SECRET=
